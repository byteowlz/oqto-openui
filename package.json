{
  "name": "@byteowlz/oqto-openui",
  "version": "0.2.1",
  "description": "Oqto OpenUI profile: shared component library, envelope schema and conformance fixtures for every Oqto host",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/*": "./schema/*"
  },
  "files": [
    "dist",
    "src",
    "schema",
    "fixtures"
  ],
  "scripts": {
    "test": "OPENUI_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 bun test",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc --noEmit",
    "check": "bun run typecheck && bun run test && bun run sync && bun run build && git diff --exit-code schema dist",
    "sync": "OPENUI_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 bun run tools/sync-upstream.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@openuidev/lang-core": "1.0.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/bun": "1.3.1",
    "@openuidev/react-ui": "0.18.1",
    "@openuidev/react-lang": "1.0.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "@types/node": "22.19.1"
  }
}
