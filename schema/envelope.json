{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "oqto.openui.part.v1"
    },
    "partId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,64}$"
    },
    "profile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "const": "oqto"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "body": {
      "type": "string",
      "minLength": 1
    },
    "fallback": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "answer": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      },
      "required": [
        "schema",
        "timeoutSeconds"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "partId",
    "profile",
    "body",
    "fallback"
  ],
  "additionalProperties": false
}
